{
 "info": {
  "name": "InventoTrack - new routes (Oct 14-16)",
  "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
  "description": "Only folders 11-13. Uses base_url, token, staff_token. Log in with your existing collection first, or set the variables by hand."
 },
 "item": [
  {
   "name": "11 - Restock suggestions (Oct 14)",
   "item": [
    {
     "name": "Suggestion for product 1 (with 'why')",
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
         "pm.test('Has reasoning', function () { const j = pm.response.json(); pm.expect(j.why).to.be.a('string'); pm.expect(j.recommended_order).to.be.at.least(0); pm.expect(['forecast','minimum_stock_rule']).to.include(j.basis); });"
        ]
       }
      }
     ],
     "request": {
      "method": "GET",
      "header": [],
      "url": {
       "raw": "{{base_url}}/suggestions/seasonal/1",
       "host": [
        "{{base_url}}"
       ],
       "path": [
        "suggestions",
        "seasonal",
        "1"
       ]
      },
      "description": "Owner only. Read the 'why' field: it explains basis, season and current stock."
     }
    },
    {
     "name": "Suggestion for product that does not exist",
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('Status is 404', function () { pm.response.to.have.status(404); });",
         "pm.test('Error format is {error, details?}', function () { const j = pm.response.json(); pm.expect(j.error).to.be.a('string'); pm.expect(Object.keys(j).every(k => ['error','details'].includes(k))).to.be.true; });"
